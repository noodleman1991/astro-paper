---
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import { Icon } from "astro-icon/components";
import { SITE } from "@/config";
import { useTranslations, type Locale } from "@/i18n";

dayjs.extend(utc);
dayjs.extend(timezone);

type Props = {
  class?: string;
  size?: "sm" | "lg";
  pubDatetime: string | Date;
  timezone?: string;
  modDatetime?: string | Date | null;
  locale?: Locale;
};

const {
  pubDatetime,
  modDatetime,
  size = "sm",
  class: className = "",
  timezone: postTimezone,
  locale = "en",
} = Astro.props;
const t = useTranslations(locale);

/* ========== Formatted Datetime ========== */
const isModified = modDatetime && modDatetime > pubDatetime;

const datetime = dayjs(isModified ? modDatetime : pubDatetime).tz(
  postTimezone || SITE.timezone
);

const date = new Intl.DateTimeFormat(locale === "he" ? "he-IL" : "en-US", {
  day: "numeric",
  month: "short",
  year: "numeric",
  timeZone: postTimezone || SITE.timezone,
}).format(datetime.toDate()); // '22 Mar, 2025' / '22 במרץ 2025'
---

<div class:list={["flex items-center gap-x-2 opacity-80", className]}>
  <Icon
    name="streamline-ultimate-color:calendar-1"
    class:list={[
      "inline-block size-6 min-w-5.5",
      { "scale-90": size === "sm" },
    ]}
  />
  {
    isModified && (
      <span class:list={["text-sm", { "sm:text-base": size === "lg" }]}>
        {t.post.updated}
      </span>
    )
  }
  <time
    class:list={["text-sm", { "sm:text-base": size === "lg" }]}
    datetime={datetime.toISOString()}>{date}</time
  >
</div>
