---
// src/components/home/ServicesBlock.astro
import { Icon } from "astro-icon/components";
import { SERVICES } from "@/config/services";
---

<section class="b-services" aria-label="What I do">
  <div class="marquee" data-marquee>
    <ul class="marquee-track" data-track>
      {
        SERVICES.map(s => (
          <li class="tile" data-set="a">
            <span class="ico" aria-hidden="true">
              <Icon name={s.icon} width={22} height={22} />
            </span>
            <span class="body">
              <span class="t">{s.title}</span>
              <span class="b">{s.blurb}</span>
            </span>
          </li>
        ))
      }
      {
        SERVICES.map(s => (
          <li class="tile" aria-hidden="true">
            <span class="ico">
              <Icon name={s.icon} width={22} height={22} />
            </span>
            <span class="body">
              <span class="t">{s.title}</span>
              <span class="b">{s.blurb}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .b-services {
    /* Query container: the tile layout responds to the CELL's width. The live
       homepage range is unaffected; the guard below only trims padding when the
       block is reused in a cramped column. */
    container-type: inline-size;
    height: 100%;
  }
  /* Narrow reuse only (< 18rem): tighten tile padding/gap so service tiles stay
     readable in a cramped column. No effect at homepage cell widths (~20rem+). */
  @container (max-width: 18rem) {
    .tile {
      padding: 0.8rem 0.9rem;
      gap: 0.65rem;
    }
    .ico {
      width: 34px;
      height: 34px;
    }
  }
  .marquee {
    height: 100%;
    overflow: hidden;
    position: relative;
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 0,
      #000 10%,
      #000 90%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to bottom,
      transparent 0,
      #000 10%,
      #000 90%,
      transparent 100%
    );
  }
  .marquee-track {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  /* Only hint the compositor while the marquee is actually animating, so an
     idle/off-screen marquee doesn't hold a paint layer for the page lifetime. */
  .marquee.playing .marquee-track {
    animation: marquee-up var(--dur, 40s) linear infinite;
    will-change: transform;
  }
  .marquee:hover .marquee-track {
    animation-play-state: paused;
  }
  @keyframes marquee-up {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(calc(-1 * var(--set-h)));
    }
  }
  .tile {
    /* gap baked in so a "set" is an exact repeating unit (no flex gap!) */
    margin-bottom: 0.7rem;
    padding: 1.05rem 1.2rem;
    background: color-mix(in srgb, var(--muted) 45%, var(--background));
    display: flex;
    gap: 0.9rem;
    align-items: center;
    flex: 0 0 auto;
  }
  .ico {
    width: 42px;
    height: 42px;
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--plum, #5d3a4a);
    background: linear-gradient(135deg, #e8837c, #ffd1c1);
  }
  .body {
    display: flex;
    flex-direction: column;
  }
  .t {
    font-family: var(--font-heading);
    font-size: 1.05rem;
  }
  .b {
    font-size: 0.82rem;
    line-height: 1.4;
    opacity: 0.85;
  }

  /* On phones the grid row uses minmax(15rem, auto), so .b-services has no
     definite height — the marquee can't clip its overflow. Give it an explicit
     cap matching the grid row min so the marquee clips correctly. */
  @media (max-width: 767px) {
    .b-services {
      height: 15rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee.playing .marquee-track {
      animation: none;
      will-change: auto;
    }
  }
</style>

<script>
  function startMarquee() {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const marquee = document.querySelector<HTMLElement>("[data-marquee]");
    const track = marquee?.querySelector<HTMLElement>("[data-track]");
    if (!marquee || !track) return;

    const SPEED = 14; // px/sec — calm drift
    let measured = false; // sizing done?
    let onScreen = false; // intersecting the viewport?

    // The animation only runs when measured AND visible AND the tab is active —
    // an off-screen or backgrounded marquee shouldn't burn CPU/GPU.
    function sync() {
      const active = measured && onScreen && !document.hidden;
      marquee!.classList.toggle("playing", active);
    }

    function measure() {
      const setTiles = track!.querySelectorAll<HTMLElement>(
        '.tile[data-set="a"]'
      );
      if (!setTiles.length) return;
      let setH = 0;
      setTiles.forEach(t => {
        setH += t.offsetHeight + parseFloat(getComputedStyle(t).marginBottom);
      });
      marquee!.style.setProperty("--set-h", `${setH}px`);
      marquee!.style.setProperty("--dur", `${setH / SPEED}s`);
      measured = true;
      sync();
    }

    // Measure after fonts load — the swap changes tile heights.
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(measure);
    } else {
      window.addEventListener("load", measure, { once: true });
    }

    const io = new IntersectionObserver(entries => {
      onScreen = entries[0]?.isIntersecting ?? false;
      sync();
    });
    io.observe(marquee);

    const onVisibility = () => sync();
    document.addEventListener("visibilitychange", onVisibility);

    let rt: number | undefined;
    const onResize = () => {
      window.clearTimeout(rt);
      rt = window.setTimeout(() => {
        measured = false;
        marquee!.classList.remove("playing");
        measure();
      }, 200);
    };
    window.addEventListener("resize", onResize);

    document.addEventListener(
      "astro:before-swap",
      () => {
        io.disconnect();
        window.removeEventListener("resize", onResize);
        document.removeEventListener("visibilitychange", onVisibility);
      },
      { once: true }
    );
  }

  document.addEventListener("astro:page-load", startMarquee);
</script>
