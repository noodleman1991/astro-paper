---
import type { Page } from "astro";
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import LinkButton from "./LinkButton.astro";
import { useTranslations, type Locale } from "@/i18n";

type Props = {
  page: Page<CollectionEntry<"blog">>;
  locale?: Locale;
};

const { page, locale = "en" } = Astro.props;
const t = useTranslations(locale);
---

{
  page.lastPage > 1 && (
    <nav
      class="mt-auto mb-8 flex justify-center"
      role="navigation"
      aria-label={t.post.paginationAria}
    >
      <LinkButton
        disabled={!page.url.prev}
        href={page.url.prev as string}
        class:list={["me-4 select-none", { "opacity-50": !page.url.prev }]}
        aria-label={t.post.gotoPrev}
      >
        <Icon name="tabler:arrow-left" class="inline-block rtl:rotate-180" />
        {t.post.prev}
      </LinkButton>
      {page.currentPage} / {page.lastPage}
      <LinkButton
        disabled={!page.url.next}
        href={page.url.next as string}
        class:list={["ms-4 select-none", { "opacity-50": !page.url.next }]}
        aria-label={t.post.gotoNext}
      >
        {t.post.next}
        <Icon name="tabler:arrow-right" class="inline-block rtl:rotate-180" />
      </LinkButton>
    </nav>
  )
}
