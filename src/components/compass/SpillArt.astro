---
import type { SpillShape } from "@/data/compass/shapes";

export type SpillTile = {
  key: string;
  tint: "k2" | "k3" | "k4";
  hero?: boolean;
  still?: boolean;
  win?: string;
  href?: string;
};

type Props = {
  shape: SpillShape;
  tiles: SpillTile[];
  stage: { w: number; h: number };
  /** Where the pour grows from (the slice's neck). */
  neck: [number, number];
  rtl: boolean;
};

const { shape, tiles, stage, neck } = Astro.props;
---

<svg
  class="cp-art"
  viewBox={`0 0 ${stage.w} ${stage.h}`}
  width={stage.w}
  height={stage.h}
  aria-hidden="true"
>
  <g filter="url(#cp-rough)">
    <g class="cp-pour" style={`transform-origin: ${neck[0]}px ${neck[1]}px`}>
      <path class="pour cp-hit" d={shape.pour}></path>
      <g class="cp-tiles">
        {
          tiles.map(t => (
            <Fragment>
              <path
                class:list={["tl", t.tint, "cp-hit", { still: t.still }]}
                d={shape.tiles[t.key].d}
                data-tile={t.key}
                data-win={t.win}
                data-href={t.href}
              />
              {t.hero && <path class="tdots" d={shape.tiles[t.key].d} />}
            </Fragment>
          ))
        }
      </g>
      <path class="cp-ants" transform="translate(5 4)" d={shape.pour}></path>
      <path class="cp-spark" d={shape.sparks}></path>
    </g>
  </g>
</svg>
