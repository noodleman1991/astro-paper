---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import HeroBlock from "@/components/home/HeroBlock.astro";
import ServicesBlock from "@/components/home/ServicesBlock.astro";
import BlogBlock from "@/components/home/BlogBlock.astro";
import PortfolioBlock from "@/components/home/PortfolioBlock.astro";
import getSortedPosts from "@/utils/getSortedPosts";

const posts = await getCollection("blog");
const recentPosts = getSortedPosts(posts).slice(0, 3);
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" class="home-layout">
    <div class="home-grid">
      <HeroBlock />
      <ServicesBlock />
      <BlogBlock posts={recentPosts} />
      <PortfolioBlock />
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .home-grid {
    display: grid;
    grid-template-columns: 1fr;
    /* Phone: blocks grow to fit their content; page scrolls naturally.
       The services marquee is bounded separately in ServicesBlock.astro.
       Roomier gap between the stacked blocks so they read as distinct cards. */
    grid-auto-rows: minmax(15rem, auto);
    gap: 2rem;
  }
  @media (min-width: 768px) {
    .home-grid {
      /* Tablet+: 2×2 fills the dynamic viewport so all four blocks show on load.
         Header is hidden at the top (Task 2), so the grid owns the full height.
         Tighter gap here since the grid must fit the viewport. */
      height: 100dvh;
      gap: 1.25rem;
      grid-template-columns: 1fr 1fr;
      /* minmax(0, 1fr) overrides the implicit `min-height: auto` so rows split
         equally and tall block content (e.g. the marquee) clips/scrolls inside
         its row instead of blowing the row out past the viewport. */
      grid-template-rows: minmax(0, 1fr) minmax(0, 1fr);
      grid-auto-rows: unset;
      padding-block: 1.25rem;
      box-sizing: border-box;
    }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
