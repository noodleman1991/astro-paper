---
import type { Page } from "astro";
import type { CollectionEntry } from "astro:content";
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import Pagination from "@/components/Pagination.astro";
import { SITE } from "@/config";
import { useTranslations, fmt, type Locale } from "@/i18n";

type Props = {
  page: Page<CollectionEntry<"blog">>;
  tag: string;
  tagName: string;
  locale: Locale;
};
const { page, tag, tagName, locale } = Astro.props;
const t = useTranslations(locale);
---

<Layout
  locale={locale}
  title={`${t.pages.tagDetail.titlePrefix} ${tagName} | ${SITE.title}`}
>
  <Header locale={locale} />
  <Main
    pageTitle={[`${t.pages.tagDetail.titlePrefix}`, `${tagName}`]}
    titleTransition={tag}
    pageDesc={fmt(t.pages.tagDetail.desc, { tag: tagName })}
    locale={locale}
  >
    <h1 slot="title" transition:name={tag}>{`Tag:${tag}`}</h1>
    <ul>
      {page.data.map(data => <Card {...data} locale={locale} />)}
    </ul>
  </Main>

  <Pagination {page} locale={locale} />

  <Footer locale={locale} noMarginTop={page.lastPage > 1} />
</Layout>
