---
import type { MarkdownLayoutProps } from "astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Layout from "./Layout.astro";
import { SITE } from "@/config";
import { useTranslations, type Locale } from "@/i18n";

type Props = MarkdownLayoutProps<{ title: string; locale?: string }>;

const { frontmatter } = Astro.props;
const locale = (frontmatter.locale ?? "en") as Locale;
const t = useTranslations(locale);
---

<Layout locale={locale} title={`${frontmatter.title} | ${SITE.title}`}>
  <Header locale={locale} />
  <Breadcrumb locale={locale} />
  <main id="main-content" class="app-layout">
    <section id="about" class="app-prose mb-28 max-w-app prose-img:border-0">
      <h1 class="font-heading text-2xl font-semibold sm:text-3xl">
        {frontmatter.title ?? t.nav.about}
      </h1>
      <slot />
    </section>
  </main>
  <Footer locale={locale} />
</Layout>
